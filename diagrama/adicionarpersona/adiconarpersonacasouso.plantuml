@startuml
left to right direction
actor "Administrador" as Admin
rectangle "Módulo Académico" {
  usecase "Adicionar Nueva Persona" as UC_Add
  usecase "Validar Datos Obligatorios" as UC_Valid
  usecase "Vincular con Usuario del Sistema" as UC_Link
  usecase "Registrar Datos Complementarios (CI)" as UC_Datos
}

Admin --> UC_Add
UC_Add --> UC_Valid
UC_Add --> UC_Link
UC_Add --> UC_Datos

note right of UC_Link
  Si la persona ya tiene usuario en public.sys_user,
  se usa su id (id ↔ idusuario).
end note
@enduml
