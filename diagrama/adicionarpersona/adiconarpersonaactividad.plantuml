@startuml
start
:Abrir pantalla "Nueva Persona";
:Completar formulario (nombre, ap, am, fnac, genero, dir, telf, tipo, ecivil, foto, idusuario);
if (Validación local OK?) then (Sí)
  :POST /api/personal (JSON);
  if (Backend valida reglas?) then (Sí)
    :Insert academico.personal;
    :Opcional: Insert/Upsert academico.datos (cedula);
    :Responder 201 (created);
    :Toast OK y redirigir a listado;
  else (No)
    :Responder 400/422 con errores;
    :Mostrar mensajes en el formulario;
  endif
else (No)
  :Resaltar campos requeridos;
endif
stop
@enduml
